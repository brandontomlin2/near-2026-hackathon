{
  "name": "near-2026-hackathon",
  "version": "0.1.0",
  "private": true,
  "description": "Own an AI personality as an NFT on NEAR: it thinks with NEAR AI and lives in a swarm with other tokens.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/require-node.mjs && node --test --test-reporter=spec 'scripts/**/*.test.mjs' 'src/**/*.test.mjs'",
    "test:contract": "cd contracts/personality-nft && cargo test",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:contract": "cd contracts/personality-nft && cargo near build non-reproducible-wasm",
    "infer": "node scripts/infer.mjs",
    "ask": "node scripts/ask.mjs",
    "anchor": "node scripts/anchor.mjs",
    "attest:check": "node scripts/attest-check.mjs",
    "verify": "bash scripts/verify.sh",
    "render": "node scripts/render-agents.mjs",
    "swarm": "node scripts/swarm.mjs",
    "demo": "node scripts/demo.mjs",
    "yield": "node scripts/yield.mjs",
    "yield:snapshot": "node scripts/yield-snapshot.mjs",
    "yield:demo": "node scripts/yield-demo.mjs",
    "yield:demo:check": "node scripts/yield-demo-check.mjs",
    "yield:shade:dry-run": "node scripts/yield-shade-dry-run.mjs",
    "yield:shade:check": "node scripts/yield-shade-check.mjs",
    "yield:live:check": "node scripts/yield-live-check.mjs",
    "yield:live:dry-run": "node scripts/yield-live.mjs dry-run",
    "yield:live:preflight": "node scripts/yield-live.mjs preflight",
    "yield:live:once": "node scripts/yield-live-once.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "readme-asset": "node scripts/readme-asset.mjs",
    "site": "node scripts/site.mjs",
    "evidence": "node scripts/evidence.mjs",
    "viewer": "node scripts/viewer.mjs",
    "deploy:nft": "node scripts/testnet-deploy.mjs deploy",
    "mint": "node scripts/testnet-deploy.mjs mint",
    "live:check": "node scripts/live-check.mjs",
    "live-proof": "node scripts/live-proof.mjs",
    "live:dry-run": "node scripts/live-proof.mjs --dry-run"
  }
}
